#!/usr/bin/env ruby
# frozen_string_literal: true

# Serves the saga console on a seeded in-memory store that keeps producing
# activity, for working on the UI without a database or RabbitMQ.
#
#   bin/web-demo                  # http://127.0.0.1:9292
#   PORT=3030 DAYS=3 bin/web-demo
#   HEAVY=1 bin/web-demo          # plus thousands of failures, a crowded step and hundreds of stalled executions
#
# Webhook deliveries are quick: most start and finish between two refreshes,
# so the map replays them.

require "bundler/setup"
require "logger"
require "zlib"
require "rackup"
require "lepus/saga"
require "lepus/saga/web"

Lepus.logger = Logger.new(File::NULL)
Lepus::Saga.configure { |config| config.store = :memory }

module WebDemo
  class GatewayTimeout < StandardError; end

  class RateLimited < StandardError; end

  class StorageUnavailable < StandardError; end

  class InventoryShortage < StandardError; end

  class ConnectionReset < StandardError; end

  class IssuerUnavailable < StandardError; end

  class CardExpired < StandardError; end

  # Simulated time: while `now` is set, Time.now and UUIDv7 ids follow it, so
  # history can be generated by the real engine in a few seconds.
  module Clock
    class << self
      attr_accessor :now

      def virtual? = !now.nil?

      def work(seconds)
        if virtual?
          self.now += seconds
        else
          sleep([seconds, 1.5].min)
        end
      end
    end

    module TimeNow
      def now(...) = Clock.now || super
    end

    module Uuid
      def uuid_v7(...)
        id = super
        return id unless Clock.now

        stamp = format("%012x", (Clock.now.to_r * 1000).to_i)
        "#{stamp[0, 8]}-#{stamp[8, 4]}#{id[13..]}"
      end
    end
  end

  Time.singleton_class.prepend(Clock::TimeNow)
  SecureRandom.singleton_class.prepend(Clock::Uuid)

  OUTBOX = Thread::Queue.new

  # Step messages go to OUTBOX instead of RabbitMQ; the simulation delivers
  # them to the executor after a delay, or loses a few.
  module Outbox
    def publish_step(execution)
      OUTBOX << {
        execution_id: execution.id, saga: execution.saga_name, step: execution.current_step,
        direction: execution.direction, epoch: execution.epoch
      }
    end
  end

  Lepus::Saga::StepProducer.singleton_class.prepend(Outbox)

  # One remote dependency per step: it takes a while, fails now and then, and
  # for a few executions keeps failing (an outage the retries cannot outlast).
  module Remote
    module_function

    def call(service, takes:, flaky:, outage:, errors:, key:)
      Clock.work(rand(takes))
      raise_error(service, errors) if rand < flaky || Zlib.crc32(key) % 1000 < outage * 1000
    end

    def raise_error(service, errors)
      error, message = errors.sample
      request(service) { raise error, message }
    end

    def request(service)
      yield
    rescue => error
      raise error.class, "#{service}: #{error.message}"
    end
  end

  class Saga < Lepus::Saga::Definition
    def self.demo_step(name, compensate: nil, takes: 0.05..0.6, flaky: 0.03, outage: 0.01, errors: [[ConnectionReset, "connection reset by peer"]], rejects: nil, **options)
      step(name, compensate: compensate, **options)
      define_method(name) do
        fail!(rejects.call(context)) if rejects && rand < 0.02
        Remote.call(name, takes: takes, flaky: flaky, outage: outage, errors: errors, key: "#{execution.id}#{name}#{execution.epoch}")
        context["#{name}_at"] = Time.now.utc.iso8601
      end
      return unless compensate

      define_method(compensate) do
        Remote.call(compensate, takes: takes, flaky: flaky / 2, outage: 0.04, errors: errors, key: "#{execution.id}#{compensate}#{execution.epoch}")
        context["#{compensate}_at"] = Time.now.utc.iso8601
      end
    end
  end

  GATEWAY = [[GatewayTimeout, "gateway timed out after 10s"], [RateLimited, "429 Too Many Requests"], [ConnectionReset, "connection reset by peer"]].freeze
  STORAGE = [[StorageUnavailable, "503 Service Unavailable"], [GatewayTimeout, "upload timed out after 30s"]].freeze

  class Checkout < Saga
    saga_name "orders.checkout"

    demo_step :reserve_inventory, compensate: :release_inventory, errors: [[InventoryShortage, "SKU 4411-B has 0 available"]], flaky: 0.02
    demo_step :authorize_payment, compensate: :void_authorization, takes: 0.3..2.5, flaky: 0.08, outage: 0.02, errors: GATEWAY, retry: {attempts: 4},
      rejects: ->(context) { "card declined (#{context["card"]})" }
    demo_step :capture_payment, compensate: :refund_payment, takes: 0.2..1.8, flaky: 0.04, errors: GATEWAY
    demo_step :create_shipment, takes: 0.2..1.2, flaky: 0.06, outage: 0.015, errors: [[RateLimited, "carrier API rate limit"], [GatewayTimeout, "carrier timed out"]], retry: {attempts: 5}
    demo_step :send_confirmation, takes: 0.05..0.3
  end

  class InvoiceIssue < Saga
    saga_name "invoices.issue"
    partition "billing"

    demo_step :assign_number, takes: 0.01..0.08, flaky: 0.005
    demo_step :render_pdf, takes: 0.4..3.5, flaky: 0.03, errors: [[ConnectionReset, "renderer closed the connection"]]
    demo_step :store_document, compensate: :delete_document, takes: 0.1..0.9, flaky: 0.05, outage: 0.02, errors: STORAGE
    demo_step :deliver_email, takes: 0.1..0.7, flaky: 0.07, errors: [[RateLimited, "mail relay throttled"]], retry: {attempts: 5}
  end

  class AccountProvision < Saga
    saga_name "accounts.provision"

    demo_step :create_tenant, compensate: :drop_tenant, takes: 0.5..4.0, flaky: 0.02
    demo_step :seed_defaults, takes: 0.3..2.0, flaky: 0.01
    demo_step :configure_billing, compensate: :cancel_billing, takes: 0.2..1.5, flaky: 0.05, outage: 0.03, errors: GATEWAY,
      rejects: ->(_context) { "billing profile rejected: missing tax id" }
    demo_step :issue_api_keys, compensate: :revoke_api_keys, takes: 0.05..0.3, flaky: 0.01
    demo_step :invite_owner, takes: 0.1..0.6, flaky: 0.04, errors: [[RateLimited, "mail relay throttled"]]
  end

  class SubscriptionRenew < Saga
    saga_name "subscriptions.renew"
    partition "billing"

    demo_step :load_plan, takes: 0.02..0.2, flaky: 0.005
    demo_step :charge_card, compensate: :refund_charge, takes: 0.4..3.0, flaky: 0.09, outage: 0.03, errors: GATEWAY, retry: {attempts: 3},
      rejects: ->(context) { "card expired (#{context["card"]})" }
    demo_step :extend_period, takes: 0.02..0.2, flaky: 0.01
    demo_step :notify_customer, takes: 0.1..0.5, flaky: 0.03, errors: [[RateLimited, "mail relay throttled"]]
  end

  class ReportExport < Saga
    saga_name "reports.export"
    partition "reports"

    demo_step :query_warehouse, takes: 2.0..45.0, flaky: 0.06, outage: 0.02, errors: [[GatewayTimeout, "statement timeout after 60s"]], retry: {attempts: 4}
    demo_step :build_archive, takes: 1.0..12.0, flaky: 0.01
    demo_step :upload_archive, compensate: :remove_archive, takes: 0.5..6.0, flaky: 0.05, errors: STORAGE
    demo_step :notify_requester, takes: 0.05..0.4, flaky: 0.02
    demo_step :expire_link, takes: 0.01..0.05, flaky: 0.0
  end

  class WebhookDeliver < Saga
    saga_name "webhooks.deliver"
    partition "webhooks"

    demo_step :reserve_slot, compensate: :release_slot, takes: 0.01..0.05, flaky: 0.0, rejects: ->(_context) { "endpoint disabled" }
    demo_step :post_payload, takes: 0.05..0.4, flaky: 0.1, outage: 0.0, errors: [[GatewayTimeout, "endpoint timed out after 2s"]], retry: {attempts: 1}
    demo_step :record_delivery, takes: 0.01..0.05, flaky: 0.01, retry: {attempts: 1}
  end

  SAGAS = [
    [Checkout, 0.36, "Order", -> { "ord_#{rand(10_000..99_999)}" }],
    [InvoiceIssue, 0.22, "Invoice", -> { "inv-2026-#{format("%05d", rand(1..30_000))}" }],
    [SubscriptionRenew, 0.2, "Subscription", -> { "sub_#{SecureRandom.hex(4)}" }],
    [AccountProvision, 0.12, "Account", -> { "acct_#{SecureRandom.hex(3)}" }],
    [ReportExport, 0.1, "Export", -> { "exp_#{rand(1000..9999)}" }],
    [WebhookDeliver, 0.15, "Webhook", -> { "whk_#{SecureRandom.hex(4)}" }]
  ].freeze
  FAST = WebhookDeliver.saga_name

  # A time-ordered queue of things to do: start a saga, deliver a step
  # message, or an operator retrying or compensating an execution.
  class Simulation
    LOST_MESSAGE = 0.006

    def initialize
      @events = []
      @mutex = Mutex.new
    end

    def schedule(time, event)
      @mutex.synchronize do
        index = @events.bsearch_index { |(other, _)| other > time } || @events.size
        @events.insert(index, [time, event])
      end
    end

    def next_due(now)
      @mutex.synchronize { @events.shift if @events.first && @events.first.first <= now }
    end

    def start_saga(now, saga = nil)
      saga, _weight, type, id = saga ? SAGAS.find { |candidate, *| candidate == saga } : SAGAS.max_by { |_, weight| rand**(1.0 / weight) }
      resource = {type: type, id: id.call}
      context = {"requested_by" => %w[api checkout-web billing-cron admin].sample, "card" => "•••• #{rand(1000..9999)}"}
      execution = saga.start(resource: resource, context: context, correlation_id: (rand < 0.6) ? "req_#{SecureRandom.hex(6)}" : nil)
      schedule(now + rand(300..3600), [:start_again, saga, resource]) if rand < 0.04
      execution
    end

    def perform(event, now)
      kind, *args = event
      case kind
      when :deliver then deliver(args.first, now)
      when :start_again then args.first.start(resource: args.last, context: {"requested_by" => "admin", "rerun" => true})
      when :retry then operate(args.first) { |execution| Lepus::Saga.retry(execution) }
      when :compensate then operate(args.first) { |execution| Lepus::Saga.compensate(execution, reason: "stuck since the carrier outage, compensated by operator") }
      end
    end

    def deliver(payload, now)
      result = Lepus::Saga::Executor.new(payload).run
      schedule(Time.now.utc + retry_delay, [:deliver, payload]) if result == :retry
      execution = Lepus::Saga.store.find_execution(payload[:execution_id])
      return unless execution && %w[failed compensation_failed].include?(execution.status) && rand < 0.35

      schedule(now + rand(600..7200), [:retry, execution.id])
    end

    def operate(id)
      execution = Lepus::Saga.store.find_execution(id)
      yield execution if execution && !execution.completed? && !execution.compensated?
    rescue Lepus::Saga::NotRetryableError
      nil
    end

    def collect_messages(now)
      while (payload = OUTBOX.pop(timeout: 0))
        if rand < LOST_MESSAGE
          schedule(now + rand(1800..14_400), [:compensate, payload[:execution_id]]) if rand < 0.4
        else
          schedule(now + delivery_delay(payload[:saga]), [:deliver, payload])
        end
      end
    end

    def delivery_delay(saga)
      return rand(0.02..0.3) if saga == FAST

      Clock.virtual? ? rand(0.2..20.0) : rand(0.5..5.0)
    end

    def retry_delay = Clock.virtual? ? rand(10.0..120.0) : rand(4.0..12.0)
  end

  # Load the simulation never reaches on its own, written straight into the
  # store: about 3,000 failed charges in a day (most in an incident six hours
  # ago), hundreds of invoices rendering at once and hundreds of stalled
  # executions.
  module HeavyLoad
    CHARGE_ERRORS = [
      [45, GatewayTimeout, "gateway timed out after 10s"],
      [24, RateLimited, "429 Too Many Requests"],
      [14, ConnectionReset, "connection reset by peer"],
      [10, IssuerUnavailable, "issuer unavailable (code 91)"],
      [7, CardExpired, "card expired"]
    ].freeze
    STALLED = [
      ["accounts.provision", "configure_billing", 210, "Account"],
      ["accounts.provision", "create_tenant", 50, "Account"],
      ["reports.export", "query_warehouse", 45, "Export"],
      ["orders.checkout", "create_shipment", 35, "Order"]
    ].freeze
    RENDERING = 420
    RENDER_SECONDS = 540

    module_function

    def store = Lepus::Saga.store

    def seed
      now = Time.now
      failed_charges(now)
      stalled(now)
      churn(Array.new(RENDERING) do
        started = now - rand * RENDER_SECONDS
        as_of(started - 2) { render(started) }
      end)
    end

    # Ids and timestamps written in the block follow `time`.
    def as_of(time)
      Clock.now = time
      yield
    ensure
      Clock.now = nil
    end

    def execution(saga, step, resource, at:, progress_at: at, **attributes)
      record = store.create_execution(
        saga_name: saga, resource_type: resource.first, resource_id: resource.last, current_step: step,
        context: {"requested_by" => "billing-cron"}, started_at: at, last_progress_at: progress_at
      )
      attributes.empty? ? record : store.update_execution(record, attributes)
    end

    def attempt(execution, step, number, at:, status:, seconds: nil, error: nil)
      error_class, message = error
      record = store.create_step_attempt(execution, step_name: step, direction: "execute", epoch: 0, attempt: number, started_at: at)
      store.update_step_attempt(record,
        status: status, finished_at: seconds && at + seconds, duration_ms: seconds && seconds * 1000.0,
        error_class: error_class&.name, error_message: message && "#{step}: #{message}")
    end

    def charge_error
      roll = rand(100)
      CHARGE_ERRORS.find { |weight, *| (roll -= weight).negative? }.drop(1)
    end

    # Each execution fails twice on charge_card before it gives up.
    def failed_charges(now)
      1_500.times do
        started = now - ((rand < 0.6) ? 5.0 + rand * 2.5 : rand * 24.0) * 3600
        as_of(started) { failed_charge(started) }
      end
    end

    def failed_charge(at)
      errors = [charge_error, charge_error]
      record = execution("subscriptions.renew", "charge_card", ["Subscription", "sub_#{SecureRandom.hex(4)}"], at: at,
        progress_at: at + 1, status: "failed", finished_at: at + 25, duration_ms: 25_000, failure_reason: "charge_card: #{errors.last.last}")
      attempt(record, "load_plan", 1, at: at, status: "succeeded", seconds: 0.1)
      attempt(record, "charge_card", 1, at: at + 1, status: "failed", seconds: 10, error: errors.first)
      attempt(record, "charge_card", 2, at: at + 14, status: "failed", seconds: 10, error: errors.last)
    end

    def stalled(now)
      STALLED.each do |saga, step, count, type|
        resource_id = SAGAS.find { |_, _, sample_type| sample_type == type }.last
        count.times do
          progress = now - (1200 + rand * 6 * 3600)
          as_of(progress - 30) { execution(saga, step, [type, resource_id.call], at: progress - 30, progress_at: progress) }
        end
      end
    end

    def render(at)
      record = execution("invoices.issue", "render_pdf", ["Invoice", "inv-2026-#{format("%05d", rand(1..99_999))}"], at: at - 2, progress_at: at)
      attempt(record, "assign_number", 1, at: at - 2, status: "succeeded", seconds: 0.05)
      attempt(record, "render_pdf", 1, at: at, status: "running")
      record.id
    end

    # Renders finish within RENDER_SECONDS and new ones take their place, so
    # the step stays crowded and never stalls.
    def churn(ids)
      Thread.new do
        loop do
          sleep 4
          now = Time.now
          ids.map! do |id|
            record = store.find_execution(id)
            next id unless record&.running?
            next id unless now - record.last_progress_at > RENDER_SECONDS || rand < 0.03

            store.update_execution(record, status: "completed", current_step: "deliver_email", last_progress_at: now, **record.finish_attributes(now))
            render(now)
          end
        rescue => error
          warn "demo churn: #{error.class}: #{error.message}"
        end
      end
    end
  end

  class << self
    def seed(simulation, days:)
      now = Time.now
      time = now - days * 86_400
      while time < now - 60
        hour = time.utc.hour
        rate = 6 + 10 * Math.sin(Math::PI * ((hour - 6) % 24) / 24.0)**2
        time += rand_exponential(3600.0 / rate)
        simulation.schedule(time, [:start])
      end
      run_virtual(simulation, until_time: now)
    end

    def run_virtual(simulation, until_time:)
      while (entry = simulation.next_due(until_time))
        time, event = entry
        Clock.now = time
        (event == [:start]) ? simulation.start_saga(time) : simulation.perform(event, time)
        simulation.collect_messages(Clock.now)
      end
    ensure
      Clock.now = nil
    end

    def run_live(simulation, workers: 4, fast_rate: 0.06)
      queue = Thread::Queue.new
      workers.times do
        Thread.new do
          loop do
            event = queue.pop
            simulation.perform(event, Time.now)
          rescue => error
            warn "demo worker: #{error.class}: #{error.message}"
          end
        end
      end
      Thread.new do
        loop do
          now = Time.now
          simulation.start_saga(now) if rand < 0.006
          simulation.start_saga(now, WebhookDeliver) if rand < fast_rate
          simulation.collect_messages(now)
          while (entry = simulation.next_due(now))
            queue << entry.last
          end
          sleep 0.1
        rescue => error
          warn "demo scheduler: #{error.class}: #{error.message}"
        end
      end
    end

    def rand_exponential(mean) = -mean * Math.log(1 - rand)
  end
end

days = Integer(ENV.fetch("DAYS", "7"))
simulation = WebDemo::Simulation.new
started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
WebDemo.seed(simulation, days: days)
WebDemo::HeavyLoad.seed if ENV["HEAVY"] == "1"
count = Lepus::Saga.store.list_executions(limit: 1_000_000).size
puts format("Seeded %d executions over %d days in %.1fs", count, days, Process.clock_gettime(Process::CLOCK_MONOTONIC) - started)
WebDemo.run_live(simulation, fast_rate: (ENV["HEAVY"] == "1") ? 0.12 : 0.06)

Lepus::Saga::Web.configure do |config|
  config.title = "Sagas demo"
  config.default_poll_interval = 5
end

port = Integer(ENV.fetch("PORT", "9292"))
puts "Saga console on http://127.0.0.1:#{port}/"
Rackup::Server.start(app: Lepus::Saga::Web, Host: ENV.fetch("HOST", "127.0.0.1"), Port: port, environment: "none")
